{
  "manifest_version": 3,
  "name": "Vertion Atendimento",
  "version": "0.2.0",
  "description": "Respostas prontas, ficha do cliente e lembretes dentro do WhatsApp Web. Nunca envia mensagem sozinha.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*"
  ],
  "action": {
    "default_title": "Vertion Atendimento",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "src/storage.js",
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
